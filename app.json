{
  "expo": {
    "name": "Imm",
    "slug": "mobile-relationship-application",
    "scheme": "imm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ivoron.mobilerelationshipapplication"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ivoron.mobilerelationshipapplication",
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4EDF7"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#74B9FF",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Imm uses your photos so you can send a photo ping to your partner.",
          "cameraPermission": "Imm uses your camera so you can send a photo ping to your partner.",
          "microphonePermission": false
        }
      ],
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a445d6c9-3fe3-4a30-93af-df1f1670c548"
      }
    },
    "owner": "ati03s-team"
  }
}
