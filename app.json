{
  "expo": {
    "name": "Imm",
    "slug": "mobile-relationship-application",
    "scheme": "imm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ivoron.mobilerelationshipapplication"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ivoron.mobilerelationshipapplication"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4EDF7"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#74B9FF",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Imm uses your photos so you can send a moment to your partner.",
          "cameraPermission": "Imm uses your camera so you can send a moment to your partner."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef3e7b09-e2bc-432b-a298-6f7521908753"
      }
    }
  }
}
