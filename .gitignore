.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase — never committed. google-services.json is read from the project
# root for local builds and from the GOOGLE_SERVICES_JSON EAS file variable for
# cloud builds (see app.config.js). Service-account keys (FCM V1) go to EAS only.
google-services.json
*firebase-adminsdk*.json
service-account*.json
